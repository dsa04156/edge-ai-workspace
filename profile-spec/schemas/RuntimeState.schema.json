{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeai:profile:v1:RuntimeState",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgeai.etri/v1"
    },
    "kind": {
      "const": "RuntimeState"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "profileRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      },
      "required": [
        "deviceId",
        "profileRef"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "Ready",
            "NotReady",
            "Unknown"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reservation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "kubernetes-pod-requests"
            },
            "capacitySource": {
              "const": "kubernetes-allocatable"
            },
            "allocatable": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpuCores": {
                  "type": "number",
                  "minimum": 0
                },
                "memoryBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "acceleratorUnits": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "cpuCores",
                "memoryBytes",
                "acceleratorUnits"
              ]
            },
            "requested": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpuCores": {
                  "type": "number",
                  "minimum": 0
                },
                "memoryBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "acceleratorUnits": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "cpuCores",
                "memoryBytes",
                "acceleratorUnits"
              ]
            },
            "available": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpuCores": {
                  "type": "number",
                  "minimum": 0
                },
                "memoryBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "acceleratorUnits": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "required": [
                "cpuCores",
                "memoryBytes",
                "acceleratorUnits"
              ]
            }
          },
          "required": [
            "source",
            "capacitySource",
            "allocatable",
            "requested",
            "available"
          ]
        },
        "utilization": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "prometheus"
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "cpuRatio": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "memoryRatio": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gpuRatio": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source",
                "observedAt",
                "cpuRatio",
                "memoryRatio",
                "gpuRatio"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "uniqueItems": true
        }
      },
      "required": [
        "phase",
        "observedAt",
        "reservation",
        "utilization",
        "reasonCodes"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "status"
  ]
}
