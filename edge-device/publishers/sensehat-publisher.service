[Unit]
Description=Sense HAT direct publisher for the edge telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=etri
WorkingDirectory=/home/etri
ExecStart=/usr/bin/python3 /home/etri/sensehat_publisher.py --agent-url http://127.0.0.1:18080/v1/events --interval 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
