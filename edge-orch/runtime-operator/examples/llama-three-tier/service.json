          "previousControllers": [
            {
              "name": "ordered-offload-controller",
              "namespace": "llama-continuity-test"
            },
            {
              "name": "continuity-controller",
              "namespace": "llama-continuity-test"
            }
          ],
          "protocol": "llama-worker-v1",
          "selector": {
            "app": "llama-spark"
          },
          "service": "llama-spark"
        },
        "runtimeClassName": "nvidia-spark",
        "nodeSelector": {
          "kubernetes.io/hostname": "etri-ser0003-cg0ms0"
        }
      }
    ]
  }
}
