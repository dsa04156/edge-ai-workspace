        }
      },
      {
        "architecture": "arm64",
        "backend": "cuda",
        "image": "docker.io/ollama/ollama@sha256:020e4134285e2ef4d8fd801234176de3b4faadc992a3eb06c8e66a2f9d4c4ba2",
        "limits": {
          "cpu": "6",
          "memory": "8Gi",
          "nvidia.com/gpu": "1"
        },
        "maxInFlight": 1,
        "name": "resident-llama-spark",
        "qualification": "8-token Llama: RPS qualification plus results/2026-09-10-latency/server-qualification.json",
        "qualifiedP95Milliseconds": 456.092,
        "qualifiedRps": 6,
        "requests": {
          "cpu": "250m",
