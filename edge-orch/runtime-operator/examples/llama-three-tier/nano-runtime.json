{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "llama-nano-runtime-cache",
        "namespace": "llama-continuity-test"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-path",
        "resources": {
          "requests": {
            "storage": "4Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "llama-nano",
        "namespace": "llama-continuity-test"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "llama-nano"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "llama-nano"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "python",
                  "/app/worker.py"
                ],
                "env": [
                  {
                    "name": "NODE_ID",
                    "value": "etri-dev0001-jetorn"
                  },
                  {
                    "name": "ROLE",
                    "value": "nano"
                  },
                  {
                    "name": "PORT",
                    "value": "18110"
                  },
                  {
                    "name": "OLLAMA_URL",
                    "value": "http://127.0.0.1:11436"
                  },
                  {
                    "name": "PYTHONDONTWRITEBYTECODE",
                    "value": "1"
                  },
                  {
                    "name": "MAX_CONCURRENCY",
                    "value": "1"
                  },
                  {
                    "name": "MODEL",
                    "value": "llama3.2:1b-instruct-q8_0"
                  }
                ],
                "image": "docker.io/library/python@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254",
                "imagePullPolicy": "IfNotPresent",
                "name": "api",
                "ports": [
                  {
                    "containerPort": 18110,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 5
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsGroup": 65532,
                  "runAsNonRoot": true,
                  "runAsUser": 65532
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/app",
                    "name": "code",
                    "readOnly": true
                  }
                ]
              },
              {
                "command": [
                  "/bin/ollama",
                  "serve"
                ],
                "env": [
                  {
                    "name": "OLLAMA_HOST",
                    "value": "127.0.0.1:11436"
                  },
                  {
                    "name": "OLLAMA_MODELS",
                    "value": "/models"
                  },
                  {
                    "name": "OLLAMA_NUM_PARALLEL",
                    "value": "1"
                  },
                  {
                    "name": "OLLAMA_MAX_LOADED_MODELS",
                    "value": "1"
                  },
                  {
                    "name": "OLLAMA_KEEP_ALIVE",
                    "value": "-1"
                  },
                  {
                    "name": "OLLAMA_KV_CACHE_TYPE",
                    "value": "q8_0"
                  },
                  {
                    "name": "NVIDIA_DRIVER_CAPABILITIES",
                    "value": "compute,utility"
                  },
                  {
                    "name": "HOME",
                    "value": "/home/ollama"
                  },
                  {
                    "name": "JETSON_JETPACK",
                    "value": "6"
                  }
                ],
                "image": "docker.io/ollama/ollama@sha256:020e4134285e2ef4d8fd801234176de3b4faadc992a3eb06c8e66a2f9d4c4ba2",
                "imagePullPolicy": "IfNotPresent",
                "name": "inference-runtime",
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi",
                    "nvidia.com/gpu.shared": "1"
                  },
                  "limits": {
                    "cpu": "6",
                    "memory": "4Gi",
                    "nvidia.com/gpu.shared": "1"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsGroup": 65532,
                  "runAsNonRoot": true,
                  "runAsUser": 65532
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/models",
                    "name": "model-cache"
                  },
                  {
                    "mountPath": "/home/ollama",
                    "name": "runtime-home"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirstWithHostNet",
            "hostNetwork": true,
            "nodeSelector": {
              "kubernetes.io/hostname": "etri-dev0001-jetorn"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 65532,
              "fsGroupChangePolicy": "OnRootMismatch"
            },
            "terminationGracePeriodSeconds": 150,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "continuity-worker-code-5tk9th46f7"
                },
                "name": "code"
              },
              {
                "name": "model-cache",
                "persistentVolumeClaim": {
                  "claimName": "llama-nano-runtime-cache"
                }
              },
              {
                "name": "runtime-home",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    }
  ]
}
