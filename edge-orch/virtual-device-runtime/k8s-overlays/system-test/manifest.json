        "name": "vd-demo-001",
        "namespace": "virtual-device-test"
      },
      "spec": {
        "replicas": 0,
        "revisionHistoryLimit": 2,
        "selector": {
          "matchLabels": {
            "edge-ai.io/virtual-device-id": "vd-demo-001"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "edge-ai.io/virtual-device-id": "vd-demo-001"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "POD_UID",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.uid"
                      }
                    }
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "vd-demo-001-settings"
                    }
                  }
                ],
                "image": "192.168.0.56:5000/virtual-device-runtime@sha256:e752b4e791796e908ba892572cf901aff5cf8646b6e075b6cb6a1971e2704315",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "httpGet": {
