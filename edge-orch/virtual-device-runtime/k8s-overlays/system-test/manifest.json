      "data": {
        "virtual_devices.json": "{\n  \"schemaVersion\": 1,\n  \"resources\": [\n    {\n      \"apiVersion\": \"augmentation.edge-ai.io/v1alpha1\",\n      \"kind\": \"AugmentationResource\",\n      \"metadata\": {\n        \"name\": \"vd-demo-001\"\n      },\n      \"spec\": {\n        \"displayName\": \"CPU Iris 분류 시험 디바이스\",\n        \"resourceType\": \"cpu\",\n        \"nodeSelector\": {\n          \"kubernetes.io/hostname\": \"etri-ser0002-cgnmsb\"\n        },\n        \"stageTypes\": [\n          \"ai_inference\"\n        ],\n        \"capabilities\": [\n          \"iris_classification\"\n        ],\n        \"runtimeRef\": {\n          \"namespace\": \"virtual-device-test\",\n          \"workloadRef\": {\n            \"kind\": \"Deployment\",\n            \"name\": \"vd-demo-001\"\n          },\n          \"podSelector\": {\n            \"edge-ai.io/virtual-device-id\": \"vd-demo-001\"\n          },\n          \"port\": 8080\n        },\n        \"model\": {\n          \"id\": \"iris-centroid\",\n          \"version\": \"1.0.0\"\n        }\n      }\n    }\n  ],\n  \"connections\": [\n    {\n      \"apiVersion\": \"augmentation.edge-ai.io/v1alpha1\",\n      \"kind\": \"DeviceAugmentation\",\n      \"metadata\": {\n        \"name\": \"jetson-vd-demo\"\n      },\n      \"spec\": {\n        \"targetDevice\": {\n          \"kind\": \"EdgeNode\",\n          \"name\": \"etri-dev0001-jetorn\"\n        },\n        \"bindings\": {\n          \"inferenceResource\": \"vd-demo-001\"\n        },\n        \"workloadPolicy\": {\n          \"mode\": \"manual_test\",\n          \"automaticOffloading\": false,\n          \"runtimeMigration\": false\n        }\n      }\n    }\n  ]\n}"
      }
    }
  ]
