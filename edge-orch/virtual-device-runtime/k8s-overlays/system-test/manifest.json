                    "port": "http"
                  },
                  "periodSeconds": 2
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                }
              }
            ],
            "nodeSelector": {
              "kubernetes.io/hostname": "etri-ser0002-cgnmsb"
            },
            "securityContext": {
              "runAsGroup": 10001,
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 35
          }
        }
