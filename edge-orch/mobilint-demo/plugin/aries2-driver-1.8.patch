diff --git a/pkg/plugin/aries/legacy.go b/pkg/plugin/aries/legacy.go
new file mode 100644
index 0000000..967b9e0
--- /dev/null
+++ b/pkg/plugin/aries/legacy.go
@@ -0,0 +1,26 @@
+package aries
+
+import (
+    "fmt"
+    "os"
+)
+
+// Explicit, node-scoped compatibility for the verified ARIES2 1.8.0 / FW 1.2 ABI.
+// No fallback on unknown versions and no write/reset/inference ioctls.
+func LegacyEnabled() bool { return os.Getenv("MOBILINT_ARIES2_DRIVER_1_8") == "true" }
+
+func legacyCheck(fd int, read func(int, uintptr) (int32, error)) error {
+    for _, c := range []struct{ nr uintptr; value int32 }{
+        {1, 0x010800}, {10, 0x010002}, {18, 2}, {19, 16},
+    } {
+        v, err := read(fd, 0x4100 | c.nr)
+        if err != nil { return fmt.Errorf("legacy ioctl %d: %w", c.nr, err) }
+        if v != c.value { return fmt.Errorf("unsupported legacy identity ioctl %d: got %d want %d", c.nr, v, c.value) }
+    }
+    for _, nr := range []uintptr{8, 9} {
+        v, err := read(fd, 0x4100 | nr)
+        if err != nil { return fmt.Errorf("legacy clock %d: %w", nr, err) }
+        if v <= 0 { return fmt.Errorf("legacy clock %d unavailable: %d", nr, v) }
+    }
+    return nil
+}
diff --git a/pkg/plugin/aries/legacy_test.go b/pkg/plugin/aries/legacy_test.go
new file mode 100644
index 0000000..0798c48
--- /dev/null
+++ b/pkg/plugin/aries/legacy_test.go
@@ -0,0 +1,23 @@
+package aries
+
+import (
+    "testing"
+    "golang.org/x/sys/unix"
+)
+func TestLegacyCheck(t *testing.T) {
+    values := map[uintptr]int32{1:0x010800,10:0x010002,18:2,19:16,8:1250000000,9:1000000000}
+    read := func(fd int, req uintptr)(int32,error){ return values[req & 255],nil }
+    if err:=legacyCheck(0,read);err!=nil { t.Fatal(err) }
+    for nr,v := range values {
+        values[nr]=0
+        if legacyCheck(0,read)==nil { t.Fatalf("accepted invalid ioctl %d",nr) }
+        values[nr]=v
+    }
+    if legacyCheck(0,func(int,uintptr)(int32,error){return 0,unix.ENOTTY})==nil {t.Fatal("accepted ioctl failure")}
+}
+func TestLegacyOptIn(t *testing.T) {
+    t.Setenv("MOBILINT_ARIES2_DRIVER_1_8", "")
+    if LegacyEnabled(){t.Fatal("must be disabled by default")}
+    t.Setenv("MOBILINT_ARIES2_DRIVER_1_8", "true")
+    if !LegacyEnabled(){t.Fatal("explicit enable failed")}
+}
diff --git a/pkg/plugin/metrics/legacy_test.go b/pkg/plugin/metrics/legacy_test.go
new file mode 100644
index 0000000..f3b9518
--- /dev/null
+++ b/pkg/plugin/metrics/legacy_test.go
@@ -0,0 +1,17 @@
+package metrics
+import (
+    "testing"
+    "net/http/httptest"
+    "strings"
+)
+func TestLegacyTelemetryUnavailable(t *testing.T) {
+    t.Setenv("MOBILINT_ARIES2_DRIVER_1_8", "true")
+    h:=NewHandler(func()bool{return true})
+    w:=httptest.NewRecorder()
+    h.ServeHTTP(w,httptest.NewRequest("GET","/metrics",nil))
+    s:=w.Body.String()
+    if !strings.Contains(s,"mobilint_legacy_telemetry_supported{device=\"aries0\"} 0") || strings.Contains(s,"mobilint_npu_memory") {t.Fatal(s)}
+    w=httptest.NewRecorder()
+    h.ServeHTTP(w,httptest.NewRequest("GET","/process",nil))
+    if w.Code!=501 {t.Fatal(w.Code)}
+}
