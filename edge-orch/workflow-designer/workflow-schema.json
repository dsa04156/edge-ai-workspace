{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mixed-Device AI Service Workflow Dry-run Plan",
  "type": "object",
  "required": ["serviceName", "mode", "inputDevices", "stages", "edges", "placements", "endpoints", "transports"],
  "additionalProperties": false,
  "properties": {
    "serviceName": { "type": "string", "minLength": 1 },
    "mode": { "const": "dry-run" },
    "inputDevices": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "name", "type", "input", "output"],
        "additionalProperties": true,
        "properties": {
          "stage": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["input", "collect", "processing", "preprocess", "ai-inference", "output", "sink"] },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "connectedDevice": { "type": "string" },
          "requiredResource": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "data", "transport"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "data": { "type": "string" },
          "transport": { "type": "string" }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "targetNode"],
        "additionalProperties": false,
        "properties": {
          "stage": { "type": "string" },
          "targetNode": { "type": "string" }
        }
      }
    },
    "endpoints": { "type": "array", "items": { "enum": ["MQTT Broker", "InfluxDB", "State Aggregator", "Dashboard"] } },
    "transports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["data", "producer", "consumer", "transport"],
        "additionalProperties": false,
        "properties": {
          "data": { "type": "string" },
          "producer": { "type": "string" },
          "consumer": { "type": "string" },
          "endpoint": { "type": "string" },
          "transport": { "type": "string" }
        }
      }
    }
  }
}
