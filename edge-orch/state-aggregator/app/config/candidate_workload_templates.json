{
  "apiVersion": "edge-ai.io/v1alpha1",
  "kind": "CandidateWorkloadTemplateCatalog",
  "templates": [
    {
      "serviceId": "sensor-anomaly-demo",
      "templateVersion": "sensor-anomaly-demo-v1",
      "allowedNamespaces": [
        "edge-ai-workloads"
      ],
      "candidateNaming": {
        "pattern": "{source}-{action}-{planSuffix}",
        "maxLength": 63
      },
      "constraints": {
        "architectures": [
          "arm64"
        ],
        "accelerator": null,
        "acceleratorUnits": {}
      },
      "statePolicy": {
        "type": "fresh_state",
        "candidateStorage": {
          "type": "ephemeral",
          "volumeName": "state",
          "mountPath": "/var/lib/sensor-anomaly-demo",
          "reuseSourcePvc": false,
          "copyExistingData": false,
          "size": null,
          "storageClassName": null,
          "accessModes": []
        }
      },
      "sourceContract": {
        "namespace": "edgex-edge",
        "kind": "Deployment",
        "name": "sensor-anomaly-demo",
        "serviceName": "sensor-anomaly-demo",
        "containerName": "sensor-anomaly-demo",
        "compatibleImages": [
          "192.168.0.56:5000/sensor-anomaly-demo@sha256:988854fa33e86d00d7b17e36362fbc99b263b8af8956a623b579851c81a11bca"
        ],
        "sourceStateVolume": {
          "volumeName": "state",
          "claimName": "sensor-anomaly-demo-state",
          "requiredAccessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "local-path"
        }
      },
      "podTemplate": {
        "labels": {
          "app.kubernetes.io/part-of": "edge-ai-service-demo",
          "edge-ai.io/local-data-client": "true"
        },
        "annotations": {},
        "automountServiceAccountToken": true,
        "serviceAccountName": "sensor-anomaly-demo-execution",
        "terminationGracePeriodSeconds": 15,
        "securityContext": {
          "fsGroup": 65532,
          "fsGroupChangePolicy": "OnRootMismatch",
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "container": {
          "name": "sensor-anomaly-demo",
          "image": "192.168.0.56:5000/sensor-anomaly-demo@sha256:988854fa33e86d00d7b17e36362fbc99b263b8af8956a623b579851c81a11bca",
          "imagePullPolicy": "IfNotPresent",
          "env": [
            {"name": "REMOTE_INFERENCE_MODE", "value": "disabled"},
            {"name": "LOCAL_DATA_BASE_URL", "value": "http://device-serial-jetson.edgex-edge.svc.cluster.local:59910"},
            {"name": "POLL_INTERVAL_SECONDS", "value": "0.5"},
            {"name": "INPUT_STALE_SECONDS", "value": "10"},
            {"name": "HTTP_TIMEOUT_SECONDS", "value": "2"},
            {"name": "WARMUP_SAMPLES", "value": "30"},
            {"name": "ANOMALY_THRESHOLD", "value": "4"},
            {"name": "STDDEV_FLOOR", "value": "1"},
            {"name": "ANOMALY_STREAK", "value": "2"},
            {"name": "CLEAR_STREAK", "value": "3"},
            {"name": "EWMA_ALPHA", "value": "0.05"},
            {"name": "RECENT_RESULT_LIMIT", "value": "1000"},
            {"name": "PENDING_TTL_SECONDS", "value": "10"},
            {"name": "MAX_PENDING_FRAMES", "value": "1000"},
            {"name": "CONTEXT_MAX_SKEW_SECONDS", "value": "2"},
            {"name": "VIBRATION_WINDOW_SAMPLES", "value": "20"},
            {"name": "TEMPERATURE_WINDOW_SAMPLES", "value": "10"},
            {"name": "VIBRATION_WEIGHT", "value": "0.7"},
            {"name": "TEMPERATURE_WEIGHT", "value": "0.3"},
            {"name": "MODEL_BACKEND", "value": "online-baseline"},
            {"name": "MODEL_VERSION", "value": "baseline-1.0.0"},
            {"name": "SERVICE_DEVICE_ID", "value": "arduino-001"},
            {"name": "SERVICE_ASSET_ID", "value": "arduino-001"},
            {"name": "SERVICE_NODE_ID", "valueFrom": {"fieldRef": {"apiVersion": "v1", "fieldPath": "spec.nodeName"}}},
            {"name": "RESULT_DB_PATH", "value": "/var/lib/sensor-anomaly-demo/results.db"},
            {"name": "RESULT_RETENTION_ROWS", "value": "100000"},
            {"name": "EXECUTION_MODE", "value": "SHADOW"},
            {"name": "EXECUTION_OWNERSHIP_ENABLED", "value": "true"},
            {"name": "EXECUTION_LEASE_NAMESPACE", "value": "edgex-edge"},
            {"name": "EXECUTION_LEASE_NAME", "value": "sensor-anomaly-demo-execution"},
            {"name": "EXECUTION_OWNER_ID", "valueFrom": {"fieldRef": {"apiVersion": "v1", "fieldPath": "metadata.labels['edge-ai.io/deployment']"}}},
            {"name": "EXECUTION_LEASE_DURATION_SECONDS", "value": "15"},
            {"name": "EXECUTION_LEASE_POLL_INTERVAL_SECONDS", "value": "2"},
            {"name": "EXECUTION_KUBERNETES_API_URL", "value": "https://192.168.0.56:6443"}
          ],
          "ports": [
            {"name": "http", "containerPort": 8080, "protocol": "TCP"}
          ],
          "startupProbe": {
            "httpGet": {"path": "/healthz", "port": "http", "scheme": "HTTP"},
            "periodSeconds": 2,
            "timeoutSeconds": 1,
            "successThreshold": 1,
            "failureThreshold": 60
          },
          "readinessProbe": {
            "httpGet": {"path": "/readyz", "port": "http", "scheme": "HTTP"},
            "periodSeconds": 5,
            "timeoutSeconds": 2,
            "successThreshold": 1,
            "failureThreshold": 6
          },
          "livenessProbe": {
            "httpGet": {"path": "/healthz", "port": "http", "scheme": "HTTP"},
            "periodSeconds": 10,
            "timeoutSeconds": 2,
            "successThreshold": 1,
            "failureThreshold": 6
          },
          "resources": {
            "requests": {"cpu": "25m", "memory": "64Mi"},
            "limits": {"cpu": "250m", "memory": "128Mi"}
          },
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 65532,
            "runAsGroup": 65532,
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": {"drop": ["ALL"]}
          },
          "volumeMounts": [
            {"name": "tmp", "mountPath": "/tmp"},
            {"name": "state", "mountPath": "/var/lib/sensor-anomaly-demo"}
          ]
        },
        "volumes": [
          {"name": "tmp", "emptyDir": {}},
          {"name": "state", "emptyDir": {}}
        ]
      }
    }
  ]
}
