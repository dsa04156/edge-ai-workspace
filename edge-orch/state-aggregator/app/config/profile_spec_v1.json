              "format": "date-time"
            },
            "reservation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "kubernetes-pod-requests"
                },
                "capacitySource": {
                  "const": "kubernetes-allocatable"
                },
                "allocatable": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpuCores": {
                      "type": "number",
                      "minimum": 0
                    },
                    "memoryBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "acceleratorUnits": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "required": [
                    "cpuCores",
                    "memoryBytes",
                    "acceleratorUnits"
                  ]
                },
                "requested": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpuCores": {
                      "type": "number",
                      "minimum": 0
                    },
                    "memoryBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "acceleratorUnits": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "required": [
                    "cpuCores",
                    "memoryBytes",
                    "acceleratorUnits"
                  ]
                },
                "available": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpuCores": {
                      "type": "number",
                      "minimum": 0
                    },
                    "memoryBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "acceleratorUnits": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "required": [
                    "cpuCores",
                    "memoryBytes",
                    "acceleratorUnits"
                  ]
                }
              },
              "required": [
                "source",
                "capacitySource",
                "allocatable",
                "requested",
                "available"
              ]
            },
            "utilization": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "const": "prometheus"
                    },
                    "observedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "cpuRatio": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "memoryRatio": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "gpuRatio": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "observedAt",
                    "cpuRatio",
                    "memoryRatio",
                    "gpuRatio"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "uniqueItems": true
            }
          },
          "required": [
            "phase",
            "observedAt",
            "reservation",
            "utilization",
            "reasonCodes"
          ]
