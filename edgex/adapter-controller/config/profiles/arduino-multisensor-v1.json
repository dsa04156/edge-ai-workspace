      "properties": {
        "valueType": "Int32",
        "readWrite": "R",
        "units": "raw"
      }
    },
    {
      "name": "acceleration_y_raw",
      "description": "Raw acceleration Y value",
      "properties": {
        "valueType": "Int32",
        "readWrite": "R",
        "units": "raw"
