#!/bin/sh
set -eu

runtime_root="${EDGEAI_DEVICE_ROOT:-/run/edgeai/devices}"
device_group="${EDGEAI_DEVICE_GROUP:-dialout}"

usage() {
  echo "usage: edgeai-device-node <add|remove> <logical-name> <major> <minor>" >&2
  exit 64
}

[ "$#" -eq 4 ] || usage

action="$1"
logical_name="$2"
major="$3"
minor="$4"

case "$action" in
  add|remove) ;;
  *) usage ;;
esac

case "$logical_name" in
  ''|*[!a-z0-9-]*|-*|*-) usage ;;
esac

case "$major" in
  ''|*[!0-9]*) usage ;;
esac

case "$minor" in
  ''|*[!0-9]*) usage ;;
esac

case "$runtime_root" in
  /*) ;;
  *) usage ;;
esac

mkdir -p "$runtime_root"
chmod 0755 "$runtime_root"

target="$runtime_root/$logical_name"
major_hex="$(printf '%x' "$major")"
minor_hex="$(printf '%x' "$minor")"

if [ "$action" = "remove" ]; then
  if [ -c "$target" ]; then
    current_device="$(stat -c '%t:%T' "$target")"
    if [ "$current_device" = "$major_hex:$minor_hex" ]; then
      rm -f "$target"
    fi
  fi
  exit 0
fi

temporary="$runtime_root/.${logical_name}.${major}.${minor}.$$"
cleanup() {
  rm -f "$temporary"
}
trap cleanup EXIT HUP INT TERM

rm -f "$temporary"
mknod "$temporary" c "$major" "$minor"
chown "root:$device_group" "$temporary"
chmod 0660 "$temporary"
mv -fT "$temporary" "$target"
trap - EXIT HUP INT TERM
