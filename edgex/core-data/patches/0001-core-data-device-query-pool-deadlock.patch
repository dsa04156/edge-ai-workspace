+func TestEventQueryUsesDeviceFirstPagination(t *testing.T) {
+	sqlStatement := sqlQueryAllEventAndDescWithCondsAndPage(originCol, deviceNameCol)
+
+	assert.Contains(t, sqlStatement, "JOIN LATERAL")
+	assert.Contains(t, sqlStatement, "event.device_info_id = device_info.id")
